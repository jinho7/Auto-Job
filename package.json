  "author": "jinho7",
  "homepage": "https://github.com/jinho7/Auto-Job#readme",
  "repository": { "type": "git", "url": "git+https://github.com/jinho7/Auto-Job.git" },
  "bugs": { "url": "https://github.com/jinho7/Auto-Job/issues" },
